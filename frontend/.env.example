# ==============================================================================
# WildLens AI — Frontend Environment Configuration Template
# ==============================================================================
# CRITICAL SECURITY RULE:
# NEVER place secret API keys (e.g. GEMINI_API_KEY, database passwords, tokens) here!
# Any variable prefixed with NEXT_PUBLIC_ is bundled into client-side JavaScript
# and is visible to any visitor in the browser.
#
# Gemini AI and backend credentials belong exclusively in backend environment variables.
# ==============================================================================

# --- FastAPI Backend Service URL ---
# Direct public API URL accessed by client browsers.
# Local development: http://localhost:8000
# LAN / Mobile hotspot: http://<laptop-lan-ip>:8000
# Deployed backend host: https://your-backend.onrender.com (or Railway, Fly.io, etc.)
# IMPORTANT: In GitHub Pages static hosting, NEVER set this to localhost or your github.io domain.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- GitHub Pages Base Path ---
# Subpath where the static export is hosted (e.g. /WildLens-AI for repository pages).
# Automatically provided in GitHub Actions CI/CD.
NEXT_PUBLIC_BASE_PATH=/WildLens-AI
