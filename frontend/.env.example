# WildLens AI Frontend Environment Configuration
#
# Production API URL: Set this to your deployed FastAPI backend service
# (e.g., on Render, Railway, Hugging Face Spaces, Fly.io, or AWS/GCP).
# IMPORTANT: In production static hosting (e.g. GitHub Pages), this must NEVER
# be localhost or the GitHub Pages domain.
#
# Direct FastAPI backend service URL (read directly from env, no secret keys required)
# Local: http://localhost:8000
# LAN / Hotspot: http://<laptop-lan-ip>:8000
# Deployed: https://your-wildlens-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000


# GitHub Pages sub-path (e.g., /WildLens-AI for repository pages, or empty for root/custom domain)
# Default for CI is automatically set by GitHub Actions.
# NEXT_PUBLIC_BASE_PATH=/WildLens-AI
