# ==============================================================================
# WildLens AI Configuration
# ==============================================================================

# --- Backend Server Configuration (FastAPI) ---
# Network binding: default 127.0.0.1 (loopback only).
# Set WILDLENS_HOST=0.0.0.0 to access from a mobile phone over a local WiFi hotspot/LAN.
# WARNING: Binding to 0.0.0.0 exposes the API to any device on the same local network.
WILDLENS_HOST=127.0.0.1
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Example: http://localhost:3000,https://suguda-thakur-marndi.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://suguda-thakur-marndi.github.io

# Vision Model Configuration (BioCLIP-2 open-weight foundation model)
VISION_DEVICE=auto
DEVICE=auto
VISION_MODEL_ID=imageomics/bioclip-2
MODEL_IDENTIFIER=imageomics/bioclip-2
MODEL_CACHE_DIR=models/bioclip_cache

# Guards & Offline Thresholds
MAX_UPLOAD_SIZE_MB=15
OUT_OF_DISTRIBUTION_THRESHOLD=0.60
HF_HUB_OFFLINE=1

# --- Frontend Client Configuration (Next.js) ---
# Direct API configuration (no secret keys needed).
# Set to your FastAPI backend address (local, LAN, or deployed cloud host).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BASE_PATH=/WildLens-AI

