# ==============================================================================
# WildLens AI — Production & Local Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# SECURITY MANDATE:
# 1. NEVER commit real .env files, API keys, or tokens to Git.
# 2. Real .env files are strictly ignored by .gitignore (.env, .env.*, .env.local).
# 3. For production deployments (Render, Railway, Fly.io, Cloud Run), configure
#    secrets exclusively through the hosting provider's Environment Variables dashboard.
# ==============================================================================

# --- Server Application Metadata ---
ENVIRONMENT=production
DEBUG=false

# --- Network & Server Binding (FastAPI / Uvicorn) ---
# Default 127.0.0.1 binds to local loopback interface only.
# Set WILDLENS_HOST=0.0.0.0 to allow access from mobile devices on a local WiFi LAN/hotspot.
# In production containers (Docker, Render, Cloud Run), 0.0.0.0 is typically required.
WILDLENS_HOST=127.0.0.1
HOST=127.0.0.1
PORT=8000

# --- CORS Allowed Origins ---
# Comma-separated list of origins permitted to access backend endpoints.
# Include local dev servers and your production frontend domain (e.g. GitHub Pages).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://suguda-thakur-marndi.github.io

# --- BioCLIP-2 Vision Foundation Model ---
# Device options: auto (detects CUDA > MPS > CPU), cuda, mps, cpu
VISION_DEVICE=auto
DEVICE=auto
VISION_MODEL_ID=imageomics/bioclip-2
MODEL_IDENTIFIER=imageomics/bioclip-2
MODEL_CACHE_DIR=models/bioclip_cache

# Hugging Face Hub offline lock:
# 1 = strictly offline, block all egress to huggingface.co once cached.
# 0 = allow online download of missing model assets during initial setup.
HF_HUB_OFFLINE=1

# Preload model weights in a worker thread on application startup:
# 1 = non-blocking background initialization (<100ms startup readiness for health checks).
# 0 = lazy load on first identification request.
PRELOAD_MODEL_BACKGROUND=1

# Optional Hugging Face Hub Access Token (Leave empty for public weights):
# Only required if using private fine-tuned models, gated checkpoints, or custom mirrors.
HF_TOKEN=

# --- Inference Guards & Quality Thresholds ---
# Maximum uploaded specimen image size (in Megabytes)
MAX_UPLOAD_SIZE_MB=15

# Out-of-distribution (OOD) rejection threshold for open-set visual inference (0.0 to 1.0).
# Specimens with top candidate similarity below this rating are flagged as inconclusive/unrepresented.
OUT_OF_DISTRIBUTION_THRESHOLD=0.60

# --- Google Gemini AI Naturalist (Optional External Cloud Provider, Backend Only) ---
# Strictly server-side secret. NEVER expose to client bundles or git commits.
# Leave empty to operate in 100% offline-safe mode with local BioCLIP-2 vision AI.
# To enable live visual explanations and nature Q&A:
#   1. Obtain a free API key from Google AI Studio: https://aistudio.google.com/
#   2. Set GEMINI_API_KEY below (or in hosting provider environment settings).
GEMINI_API_KEY=

# Base URL for Google Generative AI REST endpoints:
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Target Gemini model:
GEMINI_MODEL=gemini-2.5-flash

# Upstream request timeout (seconds):
GEMINI_TIMEOUT_SECONDS=15.0

# Max retries on transient errors:
GEMINI_MAX_RETRIES=2

# --- Frontend Client Configuration (Next.js Static Export / Build) ---
# Direct API configuration for the web browser. NO SECRET KEYS BELONG HERE.
# Local development: http://localhost:8000
# LAN / WiFi hotspot: http://<laptop-lan-ip>:8000
# Deployed cloud backend: https://your-backend-subdomain.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL subpath for GitHub Pages deployment (e.g. /WildLens-AI):
NEXT_PUBLIC_BASE_PATH=/WildLens-AI
